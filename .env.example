# Provider (OpenAI-compatible). Empty key => scripted offline demo.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_MODEL=gpt-4o-mini

# Agent behaviour
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_TEMPERATURE=0.2
TOOL_TIMEOUT_S=8
TOOL_ALLOWLIST=
AUTO_APPROVE_SENSITIVE=false

# Memory / cost
MEMORY_MAX_MESSAGES=24
SESSION_TOKEN_BUDGET=8000
INPUT_TOKEN_USD_PER_1M=0.15
OUTPUT_TOKEN_USD_PER_1M=0.60

# RAG
RAG_MIN_SCORE=0.18
RAG_TOP_K=3

# Voice
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Server
HOST=0.0.0.0
PORT=8000
